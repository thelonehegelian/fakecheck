{
  "name": "Click P to Send Text and Show Result",
  "version": "1.0",
  "description": "Clicks on p tags, sends text to backend, and opens a results tab.",
  "manifest_version": 3,
  "permissions": ["scripting", "activeTab", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Click P to Send Text"
  }
}
