#   LICENSE       Makefile	  docs	     poetry.lock  pyproject.toml


from langchain_community.document_loaders import TextLoader

root_dir = "../../../../../../libs"

docs = []
for dirpath, dirnames, filenames in os.walk(root_dir):
    for file in filenames:
