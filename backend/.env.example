# FakeCheck API Configuration Example
# Copy this file to .env and fill in your values

# ==========================================
# LLM Provider (choose one)
# ==========================================
LLM_PROVIDER=groq                           # groq or anthropic (default: groq)

# Groq Configuration (if using LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile          # llama-3.3-70b-versatile, llama-3.1-8b-instant, etc.

# Anthropic Configuration (if using LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-haiku-latest    # claude-3-5-haiku-latest, claude-3-5-sonnet-latest, etc.

# ==========================================
# Research Providers
# ==========================================

# Perplexica (Open-Source, Primary)
PERPLEXICA_ENABLED=true                     # Enable Perplexica for research (default: true)
PERPLEXICA_ENDPOINT=http://localhost:3000   # Perplexica API endpoint (use http://perplexica:3000 in Docker)
PERPLEXICA_FOCUS_MODE=webSearch             # webSearch, academicSearch, writingAssistant, wolframAlphaSearch, youtubeSearch, redditSearch
PERPLEXICA_OPTIMIZATION_MODE=balanced       # speed or balanced

# Perplexity Sonar (Fallback)
RESEARCH_FALLBACK_ENABLED=true              # Enable fallback to Perplexity Sonar (default: true)
PERPLEXITY_API_KEY=your_perplexity_api_key_here  # Only needed if fallback is enabled
PERPLEXITY_MODEL=sonar-pro                  # sonar-pro, sonar, sonar-reasoning, sonar-reasoning-pro

# ==========================================
# API Configuration
# ==========================================
MAX_TOKENS=4000                             # Maximum tokens for AI responses
REQUEST_TIMEOUT=30                          # Request timeout in seconds
RATE_LIMIT_PER_MINUTE=100                   # Rate limit for API requests

# ==========================================
# Server Configuration
# ==========================================
HOST=0.0.0.0                                # Server host
PORT=8000                                   # Server port
DEBUG=false                                 # Enable debug mode
LOG_LEVEL=INFO                              # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ==========================================
# CORS Configuration
# ==========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001  # Comma-separated list of allowed origins
CORS_ALLOW_CREDENTIALS=true                 # Allow credentials in CORS requests

# ==========================================
# Custom Prompts (Advanced)
# ==========================================
# BASE_PROMPT=Your custom fact-checking system prompt here

# ==========================================
# Twitter Bot (Optional)
# ==========================================
# TWITTER_CONSUMER_KEY=your_twitter_consumer_key
# TWITTER_CONSUMER_SECRET=your_twitter_consumer_secret
# TWITTER_ACCESS_TOKEN=your_twitter_access_token
# TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret

# ==========================================
# Reddit Configuration (Optional)
# ==========================================
# REDDIT_CLIENT_ID=your_reddit_client_id
# REDDIT_CLIENT_SECRET=your_reddit_client_secret
# REDDIT_USER_AGENT=FakeCheckBot/1.0
# REDDIT_USERNAME=your_reddit_username
# REDDIT_PASSWORD=your_reddit_password
# REDDIT_SUBREDDIT=test
